{
  "$schema": "https://biomejs.dev/schemas/1.9.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "node_modules",
      "dist",
      ".astro",
      "pnpm-lock.yaml",
      "*.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentSize": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useTemplate": "error"
      },
      "correctness": {
        "useParseIntRadix": "error",
        "noUnusedVariables": {
          "level": "warn"
        },
        "noUnusedImports": {
          "level": "warn"
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "indentSize": 2
    }
  },
  "overrides": [
    {
      "include": ["**/*.svelte"],
      "linter": {
        "enabled": true,
        "rules": {
          "correctness": {
            "noUnusedVariables": {
              "level": "off"
            },
            "noUnusedImports": {
              "level": "off"
            }
          }
        }
      }
    }
  ]
}

